{
    "name": "mysite/i.chumakov",
    "minimum-stability": "stable",
    "authors": [
        {
            "name": "i.chumakov"
        }
    ],
    "require": {
        "symfony/console": "^7.4",
        "vlucas/phpdotenv": "5.6.3",
        "wikimedia/composer-merge-plugin": "dev-master",
        "symfony/messenger": "^8.1",
        "doctrine/dbal": "^4.5",
        "symfony/doctrine-messenger": "^8.1"
    },
    "extra": {
        "merge-plugin": {
            "require": [
                "www/bitrix/composer-bx.json"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "wikimedia/composer-merge-plugin": true,
            "composer/installers": true
        }
    }
}
